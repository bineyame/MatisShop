<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_picking_form_gateway_delivery" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.gateway.delivery</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//sheet" position="inside">
                <group string="Courier" name="gateway_delivery_group"
                       invisible="not gateway_delivery_id">
                    <group>
                        <field name="gateway_delivery_provider"/>
                        <field name="gateway_delivery_status"/>
                        <field name="gateway_delivery_id"/>
                    </group>
                    <group>
                        <button name="action_refresh_delivery_status" type="object"
                                string="Refresh Courier Status" class="btn-secondary"/>
                    </group>
                </group>
            </xpath>
        </field>
    </record>
</odoo>
