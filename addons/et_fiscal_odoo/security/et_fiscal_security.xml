<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">

        <record id="module_category_et_fiscal" model="ir.module.category">
            <field name="name">Ethiopian Fiscalization</field>
            <field name="description">Access to fiscal transactions and their audit trail.</field>
            <field name="sequence">40</field>
        </record>

        <record id="group_et_fiscal_user" model="res.groups">
            <field name="name">Fiscal User</field>
            <field name="category_id" ref="module_category_et_fiscal"/>
            <field name="comment">Can see fiscal transactions and retry failed ones.</field>
        </record>

        <record id="group_et_fiscal_manager" model="res.groups">
            <field name="name">Fiscal Manager</field>
            <field name="category_id" ref="module_category_et_fiscal"/>
            <field name="implied_ids" eval="[(4, ref('group_et_fiscal_user'))]"/>
            <field name="comment">Can configure the gateway connection and cancel registrations.</field>
        </record>

        <!-- Every accounting/POS manager gets fiscal visibility by default:
             a cashier who cannot see why a receipt failed cannot act on it. -->
        <record id="base.group_system" model="res.groups">
            <field name="implied_ids" eval="[(4, ref('group_et_fiscal_manager'))]"/>
        </record>

        <!-- One deployment serves one company, but keep the record rule honest. -->
        <record id="et_fiscal_transaction_company_rule" model="ir.rule">
            <field name="name">Fiscal Transaction: multi-company</field>
            <field name="model_id" ref="model_et_fiscal_transaction"/>
            <field name="domain_force">['|', ('company_id', '=', False), ('company_id', 'in', company_ids)]</field>
            <field name="global" eval="True"/>
        </record>

    </data>
</odoo>
