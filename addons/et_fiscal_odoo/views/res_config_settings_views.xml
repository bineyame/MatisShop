<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_view_form_et_fiscal" model="ir.ui.view">
        <field name="name">res.config.settings.view.form.inherit.et.fiscal</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//form" position="inside">
                <app data-string="Ethiopian Fiscalization" string="Ethiopian Fiscalization"
                     name="et_fiscal_odoo">
                    <block title="Fiscalization" name="et_fiscal_block">
                        <setting id="et_fiscal_enabled_setting"
                                 string="Enable Fiscalization"
                                 help="Create and submit fiscal documents for POS orders and customer invoices.">
                            <field name="et_fiscal_enabled"/>
                        </setting>
                        <setting id="et_fiscal_auto_submit_setting"
                                 string="Submit Automatically"
                                 help="Submit as soon as the document is paid or posted. When off, the scheduled job submits queued documents.">
                            <field name="et_fiscal_auto_submit"/>
                        </setting>
                        <setting id="et_fiscal_retries_setting" string="Maximum Automatic Retries">
                            <field name="et_fiscal_max_auto_retries"/>
                        </setting>
                    </block>
                    <block title="Integration Gateway" name="et_fiscal_gateway_block">
                        <div class="text-muted mb-3">
                            Provider selection and provider credentials are configured in the
                            Integration Gateway, not here. Odoo only needs to know where the
                            gateway is and how to authenticate to it.
                        </div>
                        <setting id="et_fiscal_gateway_url_setting" string="Gateway URL">
                            <field name="et_fiscal_gateway_base_url" placeholder="http://gateway:8000"/>
                        </setting>
                        <setting id="et_fiscal_gateway_key_setting" string="Gateway API Key">
                            <field name="et_fiscal_gateway_api_key" password="True"/>
                        </setting>
                        <setting id="et_fiscal_gateway_timeout_setting" string="Timeout (seconds)">
                            <field name="et_fiscal_gateway_timeout"/>
                        </setting>
                        <setting id="et_fiscal_gateway_test_setting" string="Connection">
                            <button name="action_test_gateway_connection" type="object"
                                    string="Test Gateway Connection" class="btn-secondary"/>
                        </setting>
                    </block>
                </app>
            </xpath>
        </field>
    </record>
</odoo>
