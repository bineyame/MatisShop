# =============================================================================
# Mati Retail Platform - local development environment
# Copy to .env:  cp .env.example .env
# NEVER commit a real .env or real provider credentials.
# =============================================================================

# ----- PostgreSQL -------------------------------------------------------------
POSTGRES_USER=odoo
POSTGRES_PASSWORD=odoo_dev_password_change_me
POSTGRES_DB=postgres
POSTGRES_PORT=5432
# Two logical databases are created on first start by scripts/init-databases.sh
ODOO_DB_NAME=odoo
GATEWAY_DB_NAME=integration_gateway

# ----- Odoo -------------------------------------------------------------------
ODOO_PORT=8069
ODOO_LONGPOLLING_PORT=8072
# Master password for the Odoo database manager (dev only)
ODOO_ADMIN_PASSWD=admin_master_dev
# Demo login created by mati_demo (dev only)
ODOO_DEMO_LOGIN=admin
ODOO_DEMO_PASSWORD=admin

# ----- Integration Gateway ----------------------------------------------------
GATEWAY_PORT=8000
GATEWAY_ENV=development
GATEWAY_LOG_LEVEL=INFO
# Shared secret Odoo uses in the X-API-Key header. Dev value only.
GATEWAY_API_KEY=dev-gateway-api-key-change-me
# HMAC secret used to sign/verify provider webhooks. Dev value only.
GATEWAY_WEBHOOK_SECRET=dev-webhook-secret-change-me

# Active provider per rail. Swapping a provider is a configuration change.
FISCAL_PROVIDER=mock
PAYMENT_PROVIDER=mock
DELIVERY_PROVIDER=mock

# Retry policy for transient provider errors (gateway-side, per request)
GATEWAY_MAX_ATTEMPTS=3
GATEWAY_RETRY_BASE_DELAY_MS=100
GATEWAY_PROVIDER_TIMEOUT_SECONDS=10

# ----- Mock fiscal provider (demo only) --------------------------------------
# true  -> every fiscal registration fails with a retryable provider error
# false -> normal operation
MOCK_FISCAL_FAILURE_MODE=false
MOCK_FISCAL_IRN_PREFIX=ET-DEMO
# Mock payment provider behaviour: auto_success | manual | always_fail
MOCK_PAYMENT_MODE=auto_success
MOCK_DELIVERY_MODE=auto_advance

# ----- Real provider placeholders (NOT implemented - see docs/integration-contracts.md)
# ARIFPAY_API_KEY=
# ARIFPAY_BASE_URL=
# CHAPA_SECRET_KEY=
# TELEBIRR_APP_ID=
# TELEBIRR_PRIVATE_KEY_PATH=
# KLIK_API_KEY=
# MOR_FISCAL_BASE_URL=
# MOR_FISCAL_CLIENT_CERT_PATH=
